# Backend API URL (the FastAPI server)
BACKEND_URL="http://localhost:8000"

# JWT secret — must match SECRET_KEY in the backend .env
# Used by proxy.ts to cryptographically verify session tokens
SECRET_KEY="super-secret-key-change-in-production"

# Google OAuth (client ID only — no secret exposed to browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# No NEXT_PUBLIC_ vars should contain secrets
# The JWT token is stored in an httpOnly cookie, never exposed to the client

# --- Payments ---
# Public base URL of this app. The backend uses it (via its own env) to build payment
# gateway return URLs; keep in sync with pvc-api's ESEWA/KHALTI success URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# No gateway secrets belong in this file — eSewa/Khalti/ConnectIPS keys live in pvc-api/.env.
# The webhook routes (app/api/webhooks/payments/*) just forward raw payloads to BACKEND_URL.
